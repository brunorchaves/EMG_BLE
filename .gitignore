# Pastas de build ESP-IDF / SDK genérico
esp_dongle_ble/build/
emg_nrf_sdk/emg_ble/build
emg_nrf_sdk/build
blinky/

# SES (Segger Embedded Studio) — arquivos gerados pelo compilador
**/ses/Output/

# Bancada de caracterizacao de energia (power_profiling/)
# Capturas brutas da PPK2: ~400 kB/s = ~24 MB por minuto de run
power_profiling/runs/
__pycache__/
*.pyc

# Arquivos temporários de editor e SO
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Notificacao de Invencao (contem dados pessoais dos inventores - CPF, RG, endereco)
Notificacao-de-Invencao-UFMG*.docx

# Export do ensaio: os CSV decimados e metadados sao pequenos e versionaveis,
# mas o .npy de resolucao cheia (100 kS/s) chega a dezenas de MB
power_profiling/runs/**/export/*_full_uA.npy

# Player de estimulo STM32 (stm32_dac_player/): build do CMake, e o dataset da
# UCI baixado por tools/fetch_dataset.py (18 MB; o SHA-256 do zip fica no script)
stm32_dac_player/build/
stm32_dac_player/dist/
data/uci_emg_physical_action/
